{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "autodeck",
  "version": "0.1.0",
  "identifier": "com.autodeck.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1422",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AutoDeck",
        "width": 900,
        "height": 480,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0OEREQzMxQkUwNzM4MTEKUldRUk9BZStNZHlOaERFdy9aQnA4bk5WUkUvdy9DSHI5TWFCdy8rbmxBWXpqWHNCMmMxMTZrNUEK",
      "endpoints": [
        "https://github.com/33bnm3-sudo/autodeck/releases/latest/download/latest.json"
      ]
    }
  }
}
